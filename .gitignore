# Local Python environments and caches
backend/.venv/
.venv/
venv/
__pycache__/
.pytest_cache/
*.py[cod]

# Frontend dependencies and generated output
frontend/node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Local configuration and credentials (commit placeholders only)
.env
.env.*
!.env.example

# SQLite databases and transaction sidecars
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Local logs and OS files
*.log
.DS_Store
Thumbs.db

# Windows launcher runtime process ownership
.menduner-dev.json
.menduner-dev.json.tmp

# Optional preserved environment during Python version migration
backend/.venv-*/

# IDE and historical patch bundles: not part of the project.
.idea/
**/.idea/
*.patch

# Every dot-prefixed entry is local scratch: build caches, deploy staging, git worktrees,
# editor state. Three separate incidents of committing these (a Vite node cache, a deploy
# staging directory, screenshot previews) made one blanket rule the right answer instead of
# listing each directory as it was discovered.
.*
!.env.example
!frontend/.env.example

# pytest's numbered temp directories. Normally these live in the system temp directory, but a
# session that points TEMP at the workspace (done once to work around a Windows file-lock issue)
# puts them in the repository instead. They are not dot-prefixed, so the rule above misses them.
pytest-of-*/
pytest-*/

# AMap lookup output: a working file, regenerated by scripts/amap_candidates.py.
amap_candidates.json

# Upstream MediaCrawler clone: fetched per machine by tools/media-crawler/setup_xhs.cmd.
# It must never enter git — browser_data/ holds a logged-in account's session cookies,
# data/ holds third-party personal content, and .venv//.pw-browsers/ are machine-local
# builds. Tracking any of that would publish someone's login and other people's posts.
tools/MediaCrawler/

# Local screenshots for reviewing a change; never part of the project.
shot-*.png


# Generated weekly reports used to eyeball the export; never committed.
shot-report.*


# Local database copies and backups; never committed (the production DB lives on the server).
data/


# 生成物的预览图与中转 PDF（成品 pptx/docx 保留）
deliverables/preview-*/
deliverables/pdf-*/
deliverables/*.pdf
deliverables/.check-*.json
deliverables/.final-*.json
