+export type Status = 'Verified' | 'Unverified' | 'Missing' | 'Conflicting' | 'Needs Review';
+export type Category = 'government' | 'business' | 'culture' | 'education' | 'sports' | 'folk' | 'others';
+export interface Coordinates {
+    lng: number;
+    lat: number;
+    system: 'GCJ-02';
+    status: Status;
+    sourceUrl: string | null;
+}
+export interface Evidence {
+    id: string;
+    entityId: string;
+    field: string;
+    value: unknown;
+    status: Status;
+    method: string;
+    sourceName: string | null;
+    sourceUrl: string | null;
+    updatedAt: string;
+    note?: string;
+}
+export interface Event {
+    id: string;
+    name: string;
+    category: Category;
+    startDate: string | null;
+    endDate: string | null;
+    venueId: string | null;
+    districtId: string | null;
+    organizer: string | null;
+    attendance: number | null;
+    sponsor: string | null;
+    demo: boolean;
+    raw?: Record<string, unknown>;
+}
+export interface Venue {
+    id: string;
+    name: string;
+    address: string | null;
+    districtId: string | null;
+    coordinates: Coordinates | null;
+    districtDemo: boolean;
+}
+export interface Hotel {
+    id: string;
+    name: string;
+    address: string | null;
+    districtId: string | null;
+    coordinates: Coordinates | null;
+    districtDemo: boolean;
+}
+export interface District {
+    id: string;
+    name: string;
+    demo: boolean;
+    description: string;
+}
+export interface GraphNode {
+    id: string;
+    label: string;
+    kind: 'Event' | 'Venue' | 'District' | 'Hotel';
+    demo: boolean;
+    entityId: string;
+}
+export interface GraphEdge {
+    id: string;
+    source: string;
+    target: string;
+    label: string;
+    demo: boolean;
+}
+export interface Dataset {
+    events: Event[];
+    venues: Venue[];
+    hotels: Hotel[];
+    districts: District[];
+    evidence: Evidence[];
+    updatedAt: string;
+}
+export interface Filters {
+    year: number;
+    month: number;
+    district: string;
+    category: string;
+    includeDemo: boolean;
+}
