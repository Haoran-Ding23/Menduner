+import { Select, Switch, Space, Button } from 'antd';
+import { usePlatform } from '../../hooks/usePlatform';
+import { categories } from '../../utils/data';
+export default function Filters({ months = true }: {
+    months?: boolean;
+}) { const { filters, update, dataset } = usePlatform(); const years = [...new Set([2026, 2027, filters.year, ...dataset.events.flatMap(e => [e.startDate, e.endDate].filter(Boolean).map(d => Number(d!.slice(0, 4))))])].sort(); return <div className="filterbar"><Space wrap><Select aria-label="年份" value={filters.year} options={years.map(y => ({ label: `${y} 年`, value: y }))} onChange={year => update({ year })}/><Select aria-label="商圈" style={{ width: 180 }} value={filters.district} options={[{ label: '全部区域', value: '' }, ...dataset.districts.map(d => ({ label: d.name + (d.demo ? ' · DEMO' : ''), value: d.id }))]} onChange={district => update({ district })}/><Select aria-label="活动类别" style={{ width: 185 }} value={filters.category} options={[{ label: '全部活动类别', value: '' }, ...Object.entries(categories).map(([value, c]) => ({ label: c.label, value }))]} onChange={category => update({ category })}/><Switch aria-label="包含演示数据" checked={filters.includeDemo} onChange={v => update({ demo: v ? 1 : 0 })}/><span className="muted">包含 DEMO</span></Space>{months && <div className="months">{Array.from({ length: 12 }, (_, i) => <Button key={i} type={filters.month === i + 1 ? 'primary' : 'default'} onClick={() => update({ month: i + 1 })}>{i + 1}月</Button>)}</div>}</div>; }
