+import { useState } from 'react';
+import dayjs from 'dayjs';
+import { Button, Tag, Segmented, Modal, Empty, Space } from 'antd';
+import { usePlatform } from '../../hooks/usePlatform';
+import { overlaps, categories } from '../../utils/data';
+import Filters from '../../components/Filters';
+import EventCard from '../../components/EventCard';
+export default function EventCalendar() { const { dataset, filters, update, openEvent } = usePlatform(); const [mode, setMode] = useState('month'); const [week, setWeek] = useState(0); const [expanded, setExpanded] = useState<string | null>(null); const month = dayjs(`${filters.year}-${String(filters.month).padStart(2, '0')}-01`); const start = month.subtract((month.day() + 6) % 7, 'day'); const days = Array.from({ length: mode === 'month' ? 42 : 7 }, (_, i) => start.add((mode === 'week' ? week * 7 : 0) + i, 'day')); const events = dataset.events.filter(e => (filters.includeDemo || !e.demo) && (!filters.district || e.districtId === filters.district) && (!filters.category || e.category === filters.category)); const onDay = (date: string) => events.filter(e => overlaps(e, date, date)); const move = (delta: number) => { setWeek(0); const m = month.add(delta, 'month'); update({ year: m.year(), month: m.month() + 1 }); }; return <><div className="page-heading"><div className="eyebrow">TEMPORAL INTELLIGENCE</div><h1>Event Calendar <span>活动日历</span></h1><p>按完整日期范围展示活动，包括跨月和跨年活动</p></div><Filters /><div className="panel"><div className="panel-heading"><Space><Button aria-label="上个月" onClick={() => move(-1)}>←</Button><h3>{filters.year} 年 {filters.month} 月</h3><Button aria-label="下个月" onClick={() => move(1)}>→</Button></Space><Space>{mode === 'week' && <><Button disabled={week === 0} onClick={() => setWeek(v => v - 1)}>上一周</Button><span>第 {week + 1} 周</span><Button disabled={week === 5} onClick={() => setWeek(v => v + 1)}>下一周</Button></>}<Segmented value={mode} onChange={v => { setMode(String(v)); setWeek(0); }} options={[{ label: '月视图', value: 'month' }, { label: '周视图', value: 'week' }]}/></Space></div><div className="calendar-grid">{['周一', '周二', '周三', '周四', '周五', '周六', '周日'].map(d => <div className="calendar-head" key={d}>{d}</div>)}{days.map(d => { const date = d.format('YYYY-MM-DD'); const records = onDay(date); return <div className={'calendar-day ' + (d.month() + 1 !== filters.month ? 'outside' : '')} key={date}><div className="day-label">{d.date()} {records.length > 0 && <Tag>{records.length}</Tag>}</div>{records.slice(0, mode === 'week' ? 6 : 2).map(e => <button key={e.id} className="calendar-event" style={{ borderLeftColor: categories[e.category].color }} onClick={() => openEvent(e.id)}>{e.demo ? 'D · ' : ''}{e.name}</button>)}{records.length > (mode === 'week' ? 6 : 2) && <Button type="link" size="small" onClick={() => setExpanded(date)}>查看全部 {records.length} 条</Button>}</div>; })}</div></div><Modal open={!!expanded} title={expanded + ' · 当日活动'} onCancel={() => setExpanded(null)} footer={null}>{expanded && onDay(expanded).map(e => <EventCard event={e} key={e.id}/>)}</Modal>{!events.length && <Empty className="gap-top" description="当前筛选没有活动"/>}</>; }
