@@ -0,0 +1,22 @@
+import { useState, useRef } from 'react';
+import { useLocation } from 'react-router-dom';
+import { Button, Tag, Modal, Alert, Space, message, Descriptions } from 'antd';
+import { EnvironmentOutlined, CalendarOutlined, ApartmentOutlined, HomeOutlined, BarChartOutlined, SafetyCertificateOutlined, SettingOutlined, UploadOutlined } from '@ant-design/icons';
+import { usePlatform } from '../../hooks/usePlatform';
+export const pages = [{ path: '/map', title: 'City Event Map', label: '城市活动地图', icon: <EnvironmentOutlined /> }, { path: '/calendar', title: 'Event Calendar', label: '活动日历', icon: <CalendarOutlined /> }, { path: '/graph', title: 'Knowledge Graph Explorer', label: '知识图谱', icon: <ApartmentOutlined /> }, { path: '/hotels', title: 'Hotel Event Intelligence', label: '酒店活动情报', icon: <HomeOutlined /> }, { path: '/insights', title: 'District Insights', label: '商圈洞察', icon: <BarChartOutlined /> }, { path: '/evidence', title: 'Evidence & Data Quality', label: '证据与数据质量', icon: <SafetyCertificateOutlined /> }];
+export default function PlatformLayout({ children }: {
+    children: React.ReactNode;
+}) { const location = useLocation(); const { dataset, filters, go, importData, resetData } = usePlatform(); const page = pages.find(p => p.path === location.pathname); const [settings, setSettings] = useState(false); const input = useRef<HTMLInputElement>(null); const [api, holder] = message.useMessage(); return <div className="platform">{holder}<aside className="sidebar"><div className="brand"><span className="brand-symbol">M</span><div>Menduner<small>CITY EVENT INTELLIGENCE</small></div></div><div className="nav-section">工作空间 / WORKSPACE</div><nav>{pages.map(p => <button key={p.path} className={'nav-item ' + (p.path === location.pathname ? 'active' : '')} onClick={() => go(p.path)}>{p.icon}<span>{p.label}<small>{p.title}</small></span></button>)}</nav><div className="sidebar-foot"><Tag color="cyan">ENT303TC · Group 14</Tag><p>苏州 · 城市活动知识图谱</p><small>Frontend V1.0 / 本地演示</small></div></aside><div className="workspace"><header><div><span className="breadcrumb">工作空间 / </span><strong>{page?.title}</strong></div><Space><span className="header-year">{filters.year}</span><Tag color="blue">本地 JSON · {dataset.events.length} 条</Tag><Button aria-label="设置与数据导入" icon={<SettingOutlined />} onClick={() => setSettings(true)}/></Space></header><main>{children}</main></div><Modal title="设置与数据导入" open={settings} onCancel={() => setSettings(false)} footer={null}><Alert type="info" showIcon message="六页共享同一套本地数据" description="导入完整 Dataset 或活动数组。只有具有来源 URL 的已核验 GCJ-02 坐标会显示在地图上。数据仅保留于当前会话，刷新恢复样例。"/><Descriptions className="gap-top" column={1} items={[{ key: 'count', label: '活动记录', children: dataset.events.length }, { key: 'date', label: '更新时间', children: dataset.updatedAt }, { key: 'map', label: '地图配置', children: import.meta.env.VITE_AMAP_KEY && import.meta.env.VITE_AMAP_SERVICE_HOST ? '已提供配置；连接结果见地图' : '尚未配置' }]}/><Space className="gap-top"><Button icon={<UploadOutlined />} onClick={() => input.current?.click()}>导入 JSON</Button><Button onClick={() => { resetData(); api.success('已恢复 DEMO 样例'); }}>恢复演示数据</Button></Space><input ref={input} type="file" accept=".json,application/json" hidden onChange={async (e) => { const file = e.target.files?.[0]; if (!file)
+    return; try {
+    if (file.size > 10 * 1024 * 1024)
+        throw new Error('文件超过 10 MB');
+    importData(JSON.parse(await file.text()));
+    api.success('导入成功');
+    setSettings(false);
+}
+catch (error) {
+    api.error(error instanceof Error ? error.message : '导入失败');
+}
+finally {
+    e.target.value = '';
+} }}/><p className="muted">地图安全密钥由服务器读取。修改 .env.local 后需重启 npm run dev。</p></Modal></div>; }
diff --git a/frontend/src/components/Map/index.tsx b/frontend/src/components/Map/index.tsx
new file mode 100644
index 0000000..332f0fa
--- /dev/null
+++ b/frontend/src/components/Map/index.tsx
@@ -0,0 +1,89 @@
+import { useEffect, useRef, useState } from 'react';
+import { Alert, Button, Spin, Modal } from 'antd';
+import AMapLoader from '@amap/amap-jsapi-loader';
+import type { Event, Hotel } from '../../types';
+import { usePlatform } from '../../hooks/usePlatform';
+import { verifiedCoords, categories, eventCoordinates } from '../../utils/data';
+// SDK has no bundled TypeScript declarations; keep dynamic types at this boundary only.
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+type SDK = any;
+declare global {
+    interface Window {
+        _AMapSecurityConfig?: {
+            serviceHost: string;
+        };
+    }
+}
+let loading: Promise<SDK> | null = null;
+function loadSDK() { const key = import.meta.env.VITE_AMAP_KEY; const host = import.meta.env.VITE_AMAP_SERVICE_HOST; if (!key || !host || !host.endsWith('/_AMapService'))
+    return Promise.reject(new Error('configuration')); if (!loading) {
+    window._AMapSecurityConfig = { serviceHost: new URL(host, window.location.origin).href };
+    loading = AMapLoader.load({ key, version: '2.0', plugins: ['AMap.Scale', 'AMap.ToolBar'] }).catch(() => { loading = null; throw new Error('load'); });
+} return loading; }
+export default function EventMap({ events, hotel }: {
+    events: Event[];
+    hotel?: Hotel;
+}) {
+    const { dataset, repository, selected, openEvent } = usePlatform();
+    const container = useRef<HTMLDivElement>(null);
+    const map = useRef<SDK>(null);
+    const sdk = useRef<SDK>(null);
+    const [ready, setReady] = useState(false);
+    const [error, setError] = useState('');
+    const [attempt, setAttempt] = useState(0);
+    const [group, setGroup] = useState<Event[] | null>(null);
+    const [groupName, setGroupName] = useState('');
+    useEffect(() => { let cancelled = false; let timeout: ReturnType<typeof setTimeout> | undefined; setReady(false); setError(''); timeout = setTimeout(() => { if (!cancelled && !map.current)
+        setError('地图加载超时，请检查网络、Key 域名限制和本地代理。'); }, 20000); loadSDK().then(A => { if (cancelled || !container.current)
+        return; sdk.current = A; map.current = new A.Map(container.current, { zoom: 12, center: [120.716, 31.293], viewMode: '2D' }); map.current.addControl(new A.Scale()); map.current.addControl(new A.ToolBar()); map.current.on('complete', () => { if (!cancelled) {
+        clearTimeout(timeout);
+        setReady(true);
+    } }); map.current.on('error', () => { if (!cancelled)
+        setError('高德地图加载失败，请检查配置。'); }); }).catch(e => { if (!cancelled) {
+        clearTimeout(timeout);
+        setError(e.message === 'configuration' ? '地图待配置：设置 Web JSAPI Key 与安全代理。' : '地图暂不可用：请检查网络、域名白名单和安全代理。');
+    } }); return () => { cancelled = true; clearTimeout(timeout); map.current?.destroy(); map.current = null; }; }, [attempt]);
+    useEffect(() => {
+        if (!ready || !map.current)
+            return;
+        const A = sdk.current;
+        map.current.clearMap();
+        const grouped = new Map<string, {
+            events: Event[];
+            lng: number;
+            lat: number;
+            name: string;
+        }>();
+        for (const e of events) {
+            const venue = repository.getVenues().find(v => v.id === e.venueId);
+            const c = eventCoordinates(e, dataset);
+            if (!c || !venue)
+                continue;
+            const key = `${c.lng},${c.lat}`;
+            const g = grouped.get(key) ?? { events: [], lng: c.lng, lat: c.lat, name: venue.name };
+            g.events.push(e);
+            grouped.set(key, g);
+        }
+        const markers: SDK[] = [];
+        grouped.forEach(g => { const first = g.events[0]; const el = document.createElement('button'); el.className = 'map-marker'; el.style.background = categories[first.category].color; el.textContent = g.events.length > 1 ? String(g.events.length) : first.demo ? 'D' : '•'; el.setAttribute('aria-label', `${g.name}，${g.events.length} 个活动`); const marker = new A.Marker({ position: [g.lng, g.lat], content: el, anchor: 'center', title: g.name }); marker.on('click', () => { if (g.events.length === 1)
+            openEvent(first.id);
+        else {
+            setGroup(g.events);
+            setGroupName(g.name);
+        } }); markers.push(marker); });
+        if (hotel && verifiedCoords(hotel.coordinates)) {
+            const el = document.createElement('div');
+            el.className = 'map-marker hotel-marker';
+            el.textContent = 'H';
+            markers.push(new A.Marker({ position: [hotel.coordinates.lng, hotel.coordinates.lat], content: el, anchor: 'center', title: hotel.name }));
+        }
+        map.current.add(markers);
+        if (markers.length)
+            map.current.setFitView(markers, false, [70, 70, 70, 70], 14);
+        const event = events.find(e => e.id === selected);
+        const c = event ? eventCoordinates(event, dataset) : null;
+        if (c)
+            map.current.setZoomAndCenter(14, [c.lng, c.lat]);
+    }, [ready, events, hotel, dataset, repository, selected, openEvent]);
+    return <div className="map-shell"><div className="amap-container" ref={container} aria-label="苏州高德地图"/>{!ready && !error && <div className="map-state"><Spin size="large"/><h3>正在连接高德地图</h3><p>AMap JavaScript API 2.0</p></div>}{error && <div className="map-state"><span className="map-symbol">⌖</span><h2>苏州城市活动地图</h2><Alert type="warning" message={error}/><p>活动列表、日历、图谱和证据仍可使用。</p><Button onClick={() => setAttempt(v => v + 1)}>重新连接</Button></div>}<div className="map-caption">AMap 2.0 · 仅核验坐标上图 · D = DEMO · H = 酒店</div><Modal title={groupName + ' · 同址活动'} open={!!group} onCancel={() => setGroup(null)} footer={null}>{group?.map(e => <Button block className="gap-bottom" key={e.id} onClick={() => { openEvent(e.id); setGroup(null); }}>{e.name}{e.demo ? ' · DEMO' : ''}</Button>)}</Modal></div>;
+}
