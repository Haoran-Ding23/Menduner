+import { useMemo, useState } from 'react';
+import { ReactFlow, Background, Controls, MiniMap, type Node, type Edge } from '@xyflow/react';
+import '@xyflow/react/dist/style.css';
+import { Select, Switch, Tag, Button, Empty, Alert, Descriptions, Space } from 'antd';
+import { usePlatform } from '../../hooks/usePlatform';
+import { valueText } from '../../utils/data';
+const colors = { Event: '#1677ff', Venue: '#13aaba', District: '#a56be2', Hotel: '#d39725' };
+export default function KnowledgeGraph() { const { repository, dataset, selected, update, openEvent, go } = usePlatform(); const id = selected ?? dataset.events[0]?.id ?? ''; const [expanded, setExpanded] = useState(true); const [nodeId, setNodeId] = useState<string | null>(null); const [edgeId, setEdgeId] = useState<string | null>(null); const graph = useMemo(() => repository.getGraphData(id), [repository, id]); const kinds = { Event: 0, Venue: 1, District: 2, Hotel: 3 }; const nodes: Node[] = graph.nodes.filter(n => expanded || n.kind === 'Event' || n.kind === 'Venue').map(n => ({ id: n.id, data: { label: <div><small style={{ color: colors[n.kind] }}>{n.kind.toUpperCase()}{n.demo ? ' · DEMO' : ''}</small><strong>{n.label}</strong></div> }, position: { x: kinds[n.kind] * 230, y: n.kind === 'Hotel' ? 100 : 210 }, style: { border: `1px solid ${colors[n.kind]}`, borderRadius: 12, width: 185, background: '#fff', boxShadow: nodeId === n.id ? `0 0 0 3px ${colors[n.kind]}44` : '0 5px 18px #162b4710' } })); const edges: Edge[] = graph.edges.filter(e => nodes.some(n => n.id === e.source) && nodes.some(n => n.id === e.target)).map(e => ({ ...e, label: e.label + (e.demo ? ' · DEMO' : ''), animated: e.id === edgeId, style: { stroke: e.id === edgeId ? '#1677ff' : '#aab9cb', strokeWidth: e.id === edgeId ? 3 : 1.5, strokeDasharray: e.demo ? '5 4' : undefined }, labelStyle: { fontSize: 10 } })); const node = graph.nodes.find(n => n.id === nodeId); const entity = node?.kind === 'Event' ? repository.getEventById(node.entityId) : node?.kind === 'Venue' ? dataset.venues.find(v => v.id === node.entityId) : node?.kind === 'Hotel' ? dataset.hotels.find(h => h.id === node.entityId) : dataset.districts.find(d => d.id === node?.entityId); return <><div className="page-heading"><div className="eyebrow">CONNECTED KNOWLEDGE</div><h1>Knowledge Graph Explorer <span>知识图谱</span></h1><p>活动 → 场馆 → 商圈 · 查看有依据或明确标记为 DEMO 的关联</p></div><div className="panel graph-toolbar"><Space wrap><span>选择活动</span><Select aria-label="图谱活动" value={id || undefined} style={{ width: 300 }} options={dataset.events.map(e => ({ value: e.id, label: e.name + (e.demo ? ' · DEMO' : '') }))} onChange={event => { update({ event }); setNodeId(null); setEdgeId(null); }}/><Switch checked={expanded} onChange={setExpanded}/><span>展开商圈与酒店</span></Space><Space wrap>{Object.entries(colors).map(([k, c]) => <Tag color={c} key={k}>{k}</Tag>)}</Space></div><div className="graph-layout"><div className="panel graph-canvas">{nodes.length ? <ReactFlow key={id + expanded} nodes={nodes} edges={edges} fitView nodesDraggable={false} onNodeClick={(_, n) => { setNodeId(n.id); setEdgeId(null); }} onEdgeClick={(_, e) => setEdgeId(e.id)}><Background color="#dce4ed" gap={22}/><Controls /><MiniMap nodeColor={n => colors[graph.nodes.find(g => g.id === n.id)?.kind ?? 'Event']}/></ReactFlow> : <Empty description="没有可展示的图谱数据"/>}</div><section className="panel node-panel"><h3>节点详情</h3>{node ? <><Tag color={colors[node.kind]}>{node.kind}</Tag><h2>{node.label}</h2><Descriptions column={1} items={Object.entries(entity ?? {}).filter(([k]) => k !== 'raw').map(([label, value]) => ({ key: label, label, children: valueText(value) }))}/>{node.kind === 'Event' && <Button type="primary" onClick={() => openEvent(node.entityId)}>打开活动详情</Button>}{node.kind === 'Venue' && <Button onClick={() => go('/map', id)}>在地图中查看</Button>}</> : <Empty description="点击节点查看详情；点击关系线高亮"/>}{edgeId && <Alert className="gap-top" type="info" message={graph.edges.find(e => e.id === edgeId)?.label}/>}</section></div><Alert className="gap-top" type="info" showIcon message="虚线关系为 DEMO；商圈归属为演示分组。酒店仅连接商圈，没有未经验证的 Event → Hotel 经济影响边。"/></>; }
