+++ b/frontend/src/App.tsx
@@ -0,0 +1,12 @@
+import { Routes, Route, Navigate } from 'react-router-dom';
+import { Suspense, lazy } from 'react';
+import { Spin } from 'antd';
+import PlatformLayout from './components/Layout';
+import EventDetail from './components/EventDetail';
+const Map = lazy(() => import('./pages/CityEventMap'));
+const Calendar = lazy(() => import('./pages/EventCalendar'));
+const Graph = lazy(() => import('./pages/KnowledgeGraph'));
+const Hotels = lazy(() => import('./pages/HotelIntelligence'));
+const Insights = lazy(() => import('./pages/DistrictInsights'));
+const Evidence = lazy(() => import('./pages/EvidenceQuality'));
+export default function App() { return <PlatformLayout><Suspense fallback={<div className="loading-page"><Spin size="large"/></div>}><Routes><Route path="/map" element={<Map />}/><Route path="/calendar" element={<Calendar />}/><Route path="/graph" element={<Graph />}/><Route path="/hotels" element={<Hotels />}/><Route path="/insights" element={<Insights />}/><Route path="/evidence" element={<Evidence />}/><Route path="*" element={<Navigate to="/map" replace/>}/></Routes></Suspense><EventDetail /></PlatformLayout>; }
diff --git a/frontend/src/components/Charts/index.tsx b/frontend/src/components/Charts/index.tsx
new file mode 100644
index 0000000..a798374
--- /dev/null
+++ b/frontend/src/components/Charts/index.tsx
@@ -0,0 +1,7 @@
+import { useEffect, useRef } from 'react';
+import * as echarts from 'echarts';
+export default function Chart({ option, onClick }: {
+    option: echarts.EChartsOption;
+    onClick?: (name: string) => void;
+}) { const ref = useRef<HTMLDivElement>(null); useEffect(() => { if (!ref.current)
+    return; const chart = echarts.init(ref.current); chart.setOption(option); chart.on('click', p => onClick?.(String(p.name))); const resize = () => chart.resize(); const observer = new ResizeObserver(resize); observer.observe(ref.current); return () => { observer.disconnect(); chart.dispose(); }; }, [option, onClick]); return <div className="chart" ref={ref} role="img" aria-label="点击图表筛选活动"/>; }
diff --git a/frontend/src/components/EventCard/index.tsx b/frontend/src/components/EventCard/index.tsx
new file mode 100644
index 0000000..0529a49
--- /dev/null
+++ b/frontend/src/components/EventCard/index.tsx
@@ -0,0 +1,8 @@
+import { Tag } from 'antd';
+import type { Event } from '../../types';
+import { usePlatform } from '../../hooks/usePlatform';
+import { categories, dates, eventStatus, statusColors, statusLabels } from '../../utils/data';
+export default function EventCard({ event, distance }: {
+    event: Event;
+    distance?: number;
+}) { const { repository, openEvent, selected } = usePlatform(); const venue = repository.getVenues().find(v => v.id === event.venueId); const c = categories[event.category]; const status = eventStatus(repository.getEvidence(event.id)); const d = dates(event); return <button className={'event-card ' + (selected === event.id ? 'selected' : '')} onClick={() => openEvent(event.id)}><span className="event-dot" style={{ background: c.color }}/><div><div className="event-name">{event.name} {event.demo && <Tag color="blue">DEMO</Tag>}</div><div className="event-meta">{d ? `${d[0]}${d[1] !== d[0] ? ' → ' + d[1] : ''}` : '日期待确认'}</div><div className="event-meta">{venue?.name ?? '场馆待核验'}{distance !== undefined && ` · ${distance.toFixed(2)} km`}</div><div className="event-tags"><Tag color={c.color}>{c.label}</Tag><Tag color={statusColors[status]}>{statusLabels[status]}</Tag></div></div></button>; }
diff --git a/frontend/src/components/EventDetail/index.tsx b/frontend/src/components/EventDetail/index.tsx
new file mode 100644
index 0000000..9171ec9
--- /dev/null
+++ b/frontend/src/components/EventDetail/index.tsx
@@ -0,0 +1,4 @@
+import { Drawer, Descriptions, Space, Button, Tag, Alert } from 'antd';
+import { usePlatform } from '../../hooks/usePlatform';
+import { categories, valueText, statusLabels, statusColors, effectiveStatus, verifiedCoords } from '../../utils/data';
+export default function EventDetail() { const { detail, repository, closeEvent, go } = usePlatform(); const event = detail ? repository.getEventById(detail) : undefined; const venue = repository.getVenues().find(v => v.id === event?.venueId); const district = repository.getDistricts().find(d => d.id === event?.districtId); return <Drawer title="活动详情 · Event Details" width={550} open={!!detail} onClose={closeEvent}>{!event ? <Alert type="warning" message="活动不存在或已在导入后移除"/> : <>{event.demo && <Alert className="gap-bottom" type="info" showIcon message="DEMO：合成活动，用于交互演示" description="场馆坐标可独立核验；该活动并非真实活动事实。"/>}<h2>{event.name}</h2><Descriptions column={1} bordered items={Object.entries({ '活动 ID': event.id, '活动类别': categories[event.category].label, '开始日期': event.startDate, '结束日期': event.endDate, '场馆': venue?.name, '商圈': district ? district.name + (district.demo ? '（演示分组）' : '') : null, '主办方': event.organizer, '参与人数': event.attendance, '赞助方': event.sponsor, '坐标': verifiedCoords(venue?.coordinates) ? `${venue.coordinates.lng}, ${venue.coordinates.lat} · GCJ-02` : '未核验，不上图' }).map(([label, value]) => ({ key: label, label, children: valueText(value) }))}/><Space wrap className="gap-top">{[['/map', '地图'], ['/calendar', '日历'], ['/graph', '关系图谱'], ['/evidence', '证据']].map(([path, label]) => <Button key={path} onClick={() => go(path, event.id)}>查看{label}</Button>)}</Space><h3>字段证据</h3>{repository.getEvidence(event.id).map(e => <div className="evidence-row" key={e.id}><strong>{e.field}</strong><Tag color={statusColors[effectiveStatus(e)]}>{statusLabels[effectiveStatus(e)]}</Tag><span>{valueText(e.value)}</span><small>{e.method} · {e.sourceName ?? '来源待核验'}</small>{e.sourceUrl && <a href={e.sourceUrl} target="_blank" rel="noreferrer">打开原始来源 ↗</a>}</div>)}</>}</Drawer>; }
