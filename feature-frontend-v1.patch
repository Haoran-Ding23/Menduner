+] | null>(null); const range = custom ?? monthRange(filters.year, filters.month); const hotel = dataset.hotels.find(h => h.id === hotelId) ?? dataset.hotels[0]; const dated = dataset.events.filter(e => (filters.includeDemo || !e.demo) && (!filters.category || e.category === filters.category) && (!filters.district || e.districtId === filters.district) && overlaps(e, ...range)); const matches = useMemo(() => dated.flatMap(event => { const coordinates = eventCoordinates(event, dataset); if (!coordinates || !verifiedCoords(hotel?.coordinates))
+    return []; const distance = distanceKm(hotel.coordinates, coordinates); return distance !== null && distance <= radius ? [{ event, distance }] : []; }).sort((a, b) => (a.event.startDate ?? '').localeCompare(b.event.startDate ?? '') || a.distance - b.distance), [dataset.venues, dated, hotel, radius]); const unknown = dated.filter(e => !eventCoordinates(e, dataset)); return <><div className="page-heading"><div className="eyebrow">HOSPITALITY INTELLIGENCE</div><h1>Hotel Event Intelligence <span>酒店活动情报</span></h1><p>Events Worth Monitoring · 为 Revenue Manager 发现附近值得关注的活动</p></div><section className="panel hotel-toolbar"><Space wrap><Select aria-label="酒店" style={{ width: 275 }} value={hotel?.id} options={dataset.hotels.map(h => ({ label: h.name, value: h.id }))} onChange={setHotelId}/><DatePicker.RangePicker value={[dayjs(range[0]), dayjs(range[1])]} onChange={v => setCustom(v?.[0] && v[1] ? [v[0].format('YYYY-MM-DD'), v[1].format('YYYY-MM-DD')] : null)}/><span>距离 ≤ {radius} km</span><Slider min={1} max={30} value={radius} onChange={setRadius} style={{ width: 180 }}/></Space></section><Alert className="gap-top gap-bottom" type="info" showIcon message="邻近 ≠ 酒店需求或经济贡献。距离为 GCJ-02 坐标上的近似直线距离，不是道路距离。DEMO 活动不代表真实市场情报。"/><div className="hotel-layout"><section className="panel hotel-info"><div className="eyebrow">SELECTED HOTEL</div><h2>{hotel?.name ?? '未配置酒店'}</h2><Tag color={verifiedCoords(hotel?.coordinates) ? 'green' : 'orange'}>{verifiedCoords(hotel?.coordinates) ? '坐标已核验' : '坐标待核验'}</Tag><Descriptions className="gap-top" column={1} items={[{ key: 'address', label: '地址', children: hotel?.address ?? '—' }, { key: 'district', label: '商圈', children: (dataset.districts.find(d => d.id === hotel?.districtId)?.name ?? '—') + (hotel?.districtDemo ? '（DEMO）' : '') }, { key: 'count', label: '符合条件', children: `${matches.length} 条活动` }]}/>{hotel?.coordinates?.sourceUrl && <a href={hotel.coordinates.sourceUrl} target="_blank" rel="noreferrer">高德 POI 来源 ↗</a>}<div className="metric