[Unit]
Description=Menduner daily crawler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=menduner
Group=menduner
WorkingDirectory=/srv/menduner
Environment=MENDUNER_DB_PATH=/srv/menduner/data/menduner.sqlite3
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/menduner/venv/bin/python -X utf8 -m crawler.run --max-items 12
# The crawler exits 2 when the run completed but some sources did not. Some sources are
# permanently uncollectable and documented as such (damai disallows its search page in
# robots.txt; SIPAC and Subao publish no extractable event date), so without this the unit
# would report "Failed to start" every morning and the alert would be ignored. Exit 1 (a real
# crash) is still a failure, and per-source outcomes are recorded in crawl_runs / crawl_alerts.
# 2026-10-15: the two client-rendered venues (博览中心 expo, 文化艺术中心 arts) are no longer
# audit-only — they read the public JSON their own published JavaScript calls, so they now
# produce events like every other source.
SuccessExitStatus=0 2
MemoryMax=1200M
Nice=10
