# Frontend image: build the Vite bundle, then serve it from nginx which also proxies /api.
#
# Same origin for the app and the API is deliberate: the session cookie is HttpOnly and the code
# fetches relative /api paths, so shipping them from two hosts would need CORS plus a cookie
# domain and would quietly break sign-in.
FROM node:20-slim AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json /app/
RUN npm ci

COPY frontend /app
RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
