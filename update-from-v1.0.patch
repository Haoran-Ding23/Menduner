+++ b/frontend/src/services/intelligence.ts
@@ -0,0 +1,426 @@
+import type { Category, Dataset, Event, Hotel } from "../types";
+import {
+  dates,
+  distanceKm,
+  effectiveStatus,
+  eventCoordinates,
+  safeUrl,
+  verifiedCoords,
+  overlaps,
+  monthRange,
+} from "../utils/data";
+
+export type ImpactLevel = "HIGH" | "MEDIUM" | "LOW" | "UNKNOWN";
+export interface DemandAssessment {
+  level: ImpactLevel;
+  score: number | null;
+  basis: "DEMO" | "RULE_BASED" | "INSUFFICIENT";
+  reasons: string[];
+  nearbyHotels: { hotel: Hotel; distance: number }[];
+  radiusKm: number;
+  nearestDistance: number | null;
+}
+export const impactColors = {
+  HIGH: "red",
+  MEDIUM: "gold",
+  LOW: "blue",
+  UNKNOWN: "default",
+};
+export const categoryWeights: Record<Category, number> = {
+  business: 45,
+  culture: 30,
+  education: 30,
+  sports: 25,
+  folk: 20,
+  government: 15,
+  others: 10,
+};
+export function verifiedField(event: Event, data: Dataset, field: keyof Event) {
+  const evidence = data.evidence.filter(
+    (e) => e.entityId === event.id && e.field === field,
+  );
+  // An unresolved competing value suppresses assessment, even alongside a verified source.
+  return (
+    !evidence.some((e) =>
+      ["Conflicting", "Needs Review"].includes(effectiveStatus(e)),
+    ) &&
+    evidence.some(
+      (e) => effectiveStatus(e) === "Verified" && e.value === event[field],
+    )
+  );
+}
+export function nearbyHotels(event: Event, data: Dataset, radiusKm = 10) {
+  const coordinate = eventCoordinates(event, data);
+  if (!coordinate) return [];
+  return data.hotels
+    .flatMap((hotel) => {
+      if (!verifiedCoords(hotel.coordinates)) return [];
+      const distance = distanceKm(coordinate, hotel.coordinates);
+      return distance !== null && distance <= radiusKm
+        ? [{ hotel, distance }]
+        : [];
+    })
+    .sort((a, b) => a.distance - b.distance);
+}
+/** A transparent review-priority heuristic, NEVER a forecast or likelihood of demand. */
+export function assessDemand(
+  event: Event,
+  data: Dataset,
+  radiusKm = 10,
+): DemandAssessment {
+  const hotels = nearbyHotels(event, data, radiusKm);
+  const result: DemandAssessment = {
+    level: "UNKNOWN",
+    score: null,
+    basis: "INSUFFICIENT",
+    reasons: [],
+    nearbyHotels: hotels,
+    radiusKm,
+    nearestDistance: hotels[0]?.distance ?? null,
+  };
+  const interval = dates(event);
+  if (!interval) {
+    result.reasons.push("日期缺失或范围无效，无法判断复核时间。");
+    return result;
+  }
+  if (!eventCoordinates(event, data)) {
+    result.reasons.push("活动场馆关系或坐标未核验，无法判断空间关联。");
+    return result;
+  }
+  if (
+    !event.demo &&
+    (!verifiedField(event, data, "startDate") ||
+      !verifiedField(event, data, "category") ||
+      (event.endDate !== null && !verifiedField(event, data, "endDate")))
+  ) {
+    result.reasons.push("真实活动日期或类别缺少一致的字段证据，暂不分级。");
+    return result;
+  }
+  const duration =
+    Math.floor((Date.parse(interval[1]) - Date.parse(interval[0])) / 86400000) +
+    1;
+  const categoryScore = categoryWeights[event.category],
+    durationScore = duration >= 2 ? 15 : 0,
+    proximityScore = hotels.length ? 15 : 0;
+  const score = categoryScore + durationScore + proximityScore;
+  return {
+    ...result,
+    score,
+    level: score >= 70 ? "HIGH" : score >= 40 ? "MEDIUM" : "LOW",
+    basis: event.demo ? "DEMO" : "RULE_BASED",
+    reasons: [
+      `类别规则 ${categoryScore} 分（商业45、文化/教育30、体育25、民俗20、政府15、其他10）`,
+      event.endDate === null
+        ? "结束日期未知：不假定持续天数，多日加分 0"
+        : `持续 ${duration} 天：${durationScore} 分（多日 +15）`,
+      `${radiusKm} km 内配置且核验酒店 ${hotels.length} 家：${proximityScore} 分（有酒店 +15）`,
+      "HIGH ≥70；MEDIUM ≥40；LOW <40。规则未经需求数据校准。",
+    ],
+  };
+}
+export function shiftDate(date: string, delta: number) {
+  return new Date(Date.parse(date + "T00:00:00Z") + delta * 86400000)
+    .toISOString()
+    .slice(0, 10);
+}
+export function businessToday(now = new Date()) {
+  const parts = new Intl.DateTimeFormat("en-CA", {
+    timeZone: "Asia/Shanghai",
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).formatToParts(now);
+  return ["year", "month", "day"]
+    .map((type) => parts.find((p) => p.type === type)!.value)
+    .join("-");
+}
+export function reviewPlan(
+  event: Event,
+  assessment: DemandAssessment,
+  today = businessToday(),
+) {
+  if (!event.startDate || assessment.level === "UNKNOWN")
+    return {
+      action: "先核验活动日期、类别和场馆来源",
+      window: null,
+      timing: "信息不足",
+    };
+  const start = shiftDate(event.startDate, -14),
+    end = shiftDate(event.startDate, -7);
+  const timing =
+    today < start
+      ? "待计划"
+      : today <= end
+        ? "进入复核窗口"
+        : today < event.startDate
+          ? "复核窗口已过，请人工检查"
+          : event.endDate === null
+            ? "活动已开始，结束时间待核验"
+            : dates(event) && today <= dates(event)![1]
+              ? "活动进行中，请复核当前情况"
+              : "活动已结束，适合回顾";
+  return {
+    action:
+      assessment.level === "HIGH"
+        ? "建议人工复核房价、预订节奏和库存；结合 RMS 判断"
+        : assessment.level === "MEDIUM"
+          ? "关注客群及渠道变化，评估是否需要价格复核"
+          : "持续监测活动与预订变化",
+    window: [start, end] as [string, string],
+    timing,
+  };
+}
+export function evidenceSummary(event: Event, data: Dataset) {
+  const eventEvidence = data.evidence.filter((e) => e.entityId === event.id),
+    venueEvidence = data.evidence.filter((e) => e.entityId === event.venueId);
+  const urls = (items: typeof eventEvidence) => [
+    ...new Set(
+      items
+        .filter((e) => effectiveStatus(e) === "Verified")
+        .map((e) => safeUrl(e.sourceUrl))
+        .filter((u): u is string => !!u),
+    ),
+  ];
+  return {
+    eventUrls: urls(eventEvidence),
+    venueUrls: urls(venueEvidence),
+    updatedAt:
+      [...eventEvidence, ...venueEvidence]
+        .map((e) => e.updatedAt)
+        .filter((x) => !isNaN(Date.parse(x)))
+        .sort((a, b) => Date.parse(b) - Date.parse(a))[0] ?? null,
+  };
+}
+export function highImpactPeriods(
+  events: Event[],
+  data: Dataset,
+  year: number,
+  month: number,
+) {
+  const [start, end] = monthRange(year, month);
+  const high = events.filter((e) => assessDemand(e, data).level === "HIGH");
+  const active: string[] = [];
+  for (let date = start; date <= end; date = shiftDate(date, 1))
+    if (high.some((e) => overlaps(e, date, date))) active.push(date);
+  const periods: { start: string; end: string }[] = [];
+  for (const date of active) {
+    const last = periods.at(-1);
+    if (last && shiftDate(last.end, 1) === date) last.end = date;
+    else periods.push({ start: date, end: date });
+  }
+  return periods;
+}
+export function upcomingHighEvents(
+  events: Event[],
+  data: Dataset,
+  today = businessToday(),
+) {
+  // Exactly 30 calendar dates, including today; ongoing events are included.
+  const end = shiftDate(today, 29);
+  return events
+    .filter(
+      (e) => overlaps(e, today, end) && assessDemand(e, data).level === "HIGH",
+    )
+    .sort((a, b) => (a.startDate ?? "").localeCompare(b.startDate ?? ""));
+}
+
+export interface DistrictOpportunity {
+  id: string;
+  name: string;
+  events: number;
+  businessEvents: number;
+  configuredHotels: number;
+  score: number | null;
+  potential: ImpactLevel;
+  demo: boolean;
+  reasons: string[];
+}
+export function districtOpportunities(
+  events: Event[],
+  data: Dataset,
+): DistrictOpportunity[] {
+  return data.districts.map((district) => {
+    const records = events.filter((e) => e.districtId === district.id);
+    const business = records.filter((e) => e.category === "business").length;
+    const hotelCount = data.hotels.filter(
+      (h) => h.districtId === district.id && verifiedCoords(h.coordinates),
+    ).length;
+    const score = records.length
+      ? Math.round(
+          Math.min(records.length, 10) * 4 +
+            (business / records.length) * 40 +
+            (Math.min(hotelCount, 3) / 3) * 20,
+        )
+      : null;
+    return {
+      id: district.id,
+      name: district.name,
+      events: records.length,
+      businessEvents: business,
+      configuredHotels: hotelCount,
+      score,
+      potential:
+        score === null
+          ? "UNKNOWN"
+          : score >= 60
+            ? "HIGH"
+            : score >= 30
+              ? "MEDIUM"
+              : "LOW",
+      demo: district.demo || records.some((e) => e.demo),
+      reasons: [
+        `样本活动数 min(${records.length},10) ×4`,
+        `商业活动占比 ×40；核验坐标的配置酒店数 min(${hotelCount},3)/3 ×20`,
+        "HIGH ≥60；MEDIUM ≥30；LOW <30。非市场容量、酒店密度或收益预测。",
+      ],
+    };
+  });
+}
+export const customerHypotheses: Record<
+  Category,
+  { industry: string; segment: string }
+> = {
+  business: { industry: "Business / 商务", segment: "商务出行关注信号" },
+  culture: { industry: "Entertainment / 娱乐", segment: "文娱观众关注信号" },
+  education: { industry: "Education / 教育", segment: "学术访客关注信号" },
+  sports: { industry: "Sports / 体育", segment: "赛事参与者关注信号" },
+  folk: { industry: "Tourism / 文旅", segment: "文旅访客关注信号" },
+  government: { industry: "Other / 其他", segment: "公共活动访客关注信号" },
+  others: { industry: "Other / 其他", segment: "客群待判断" },
+};
+export function industryBreakdown(events: Event[]) {
+  const labels = [
+    "Business / 商务",
+    "Tourism / 文旅",
+    "Education / 教育",
+    "Entertainment / 娱乐",
+    "Sports / 体育",
+    "Other / 其他",
+  ];
+  return labels.map((name) => ({
+    name,
+    count: events.filter(
+      (e) => customerHypotheses[e.category].industry === name,
+    ).length,
+    categories: (Object.keys(customerHypotheses) as Category[]).filter(
+      (category) => customerHypotheses[category].industry === name,
+    ),
+  }));
+}
+
+export interface PrototypeQueryResult {
+  supported: boolean;
+  message: string;
+  events: Event[];
+  districtId?: string;
+  year?: number;
+  month?: number;
+}
+export function queryPrototype(
+  query: string,
+  data: Dataset,
+  context: { year: number; month: number; includeDemo: boolean },
+): PrototypeQueryResult {
+  const noMatch = (message: string): PrototypeQueryResult => ({
+    supported: false,
+    message,
+    events: [],
+  });
+  if (!/(events?|活动)/i.test(query) || !/(hotels?|酒店)/i.test(query))
+    return noMatch(
+      "此原型仅支持按商圈与月份查询酒店值得关注的活动；无法回答收益预测或任意问题。",
+    );
+  const district = /(jinji\s*lake|金鸡湖)/i.test(query)
+    ? data.districts.find((d) => d.name.includes("金鸡湖"))
+    : /(dushu\s*lake|独墅湖)/i.test(query)
+      ? data.districts.find((d) => d.name.includes("独墅湖"))
+      : undefined;
+  if (!district)
+    return noMatch("请明确金鸡湖或独墅湖商圈；数据中也必须存在该商圈。");
+  const english = [
+    "january",
+    "february",
+    "march",
+    "april",
+    "may",
+    "june",
+    "july",
+    "august",
+    "september",
+    "october",
+    "november",
+    "december",
+  ];
+  const englishMonth = english.findIndex((name) =>
+    new RegExp(`\b${name}\b`, "i").test(query),
+  );
+  const chinese = query.match(/(\d{1,2})\s*月/);
+  const month = chinese
+    ? Number(chinese[1])
+    : englishMonth >= 0
+      ? englishMonth + 1
+      : context.month;
+  const yearMatch = query.match(/\b(20\d{2})\b/);
+  const year = yearMatch ? Number(yearMatch[1]) : context.year;
+  if (month < 1 || month > 12) return noMatch("月份必须在1–12之间。");
+  const districtHotels = data.hotels.filter(
+    (h) => h.districtId === district.id && verifiedCoords(h.coordinates),
+  );
+  const events = data.events.filter(
+    (e) =>
+      (context.includeDemo || !e.demo) &&
+      e.districtId === district.id &&
+      overlaps(e, ...monthRange(year, month)) &&
+      assessDemand(e, data).level === "HIGH" &&
+      nearbyHotels(e, data).some(({ hotel }) =>
+        districtHotels.some((h) => h.id === hotel.id),
+      ),
+  );
+  return {
+    supported: true,
+    message: `${year}年${month}月，${district.name}已配置酒店附近有 ${events.length} 个 HIGH 复核优先级活动。${district.demo ? "商圈归属为 DEMO 分组。" : ""}这不是需求或收入预测。`,
+    events,
+    districtId: district.id,
+    year,
+    month,
+  };
+}
+export interface ConflictCandidate {
+  id: string;
+  value: string;
+  sourceName: string;
+  sourceRole: "official_organizer" | "government" | "venue" | "other";
+  demo: boolean;
+}
+export function resolveDemoConflict(candidates: ConflictCandidate[]) {
+  if (!candidates.length || candidates.some((c) => !c.demo))
+    return {
+      selected: null,
+      reason: "仅支持合成候选的演示，不替真实证据作自动裁决。",
+    };
+  if (
+    candidates.some(
+      (c) =>
+        !/^\d{4}-\d{2}-\d{2}$/.test(c.value) ||
+        !dates({ startDate: c.value, endDate: c.value } as Event),
+    )
+  )
+    return { selected: null, reason: "候选日期无效，交人工复核。" };
+  const rank = { official_organizer: 4, government: 3, venue: 2, other: 1 };
+  const sorted = [...candidates].sort(
+    (a, b) => rank[b.sourceRole] - rank[a.sourceRole],
+  );
+  const preferred = sorted.filter(
+    (c) => rank[c.sourceRole] === rank[sorted[0].sourceRole],
+  );
+  if (new Set(preferred.map((c) => c.value)).size > 1)
+    return {
+      selected: null,
+      reason: "同等优先来源日期冲突，保留冲突并交人工复核。",
+    };
+  return {
+    selected: sorted[0],
+    reason:
+      "DEMO 规则：主办方官网 > 政府 > 场馆 > 其他。此候选来源角色是合成输入，真实场景还须核对发布时间、活动身份及取消/变更通知。",
+  };
+}
