@@ -0,0 +1,86 @@
+import { Alert, Button, Empty, Space, Tag } from "antd";
+import type { Event } from "../../types";
+import { usePlatform } from "../../hooks/usePlatform";
+import {
+  businessToday,
+  highImpactPeriods,
+  upcomingHighEvents,
+  shiftDate,
+} from "../../services/intelligence";
+import { ImpactTag } from "../DemandIntelligence";
+export default function RevenueOutlook({
+  events,
+  onPeriod,
+}: {
+  events: Event[];
+  onPeriod: (start: string, end: string) => void;
+}) {
+  const { dataset, filters, openEvent } = usePlatform();
+  const today = businessToday();
+  const periods = highImpactPeriods(
+    events,
+    dataset,
+    filters.year,
+    filters.month,
+  );
+  const upcoming = upcomingHighEvents(events, dataset, today);
+  return (
+    <div className="outlook-grid gap-bottom">
+      <section className="panel">
+        <div className="panel-heading">
+          <h3>{filters.month}月 Demand Outlook · 复核重点时段</h3>
+          <Tag color="blue">从 HIGH 记录计算</Tag>
+        </div>
+        <div className="outlook-content">
+          <Alert
+            type="info"
+            message="重点时段是规则分级结果，不是已验证高需求日期。"
+          />
+          {periods.length ? (
+            <Space wrap className="gap-top">
+              {periods.map((p) => (
+                <Button key={p.start} onClick={() => onPeriod(p.start, p.end)}>
+                  {p.start} → {p.end}
+                </Button>
+              ))}
+            </Space>
+          ) : (
+            <Empty description="本月没有可分级的 HIGH 活动时段" />
+          )}
+          <small className="block muted gap-top">
+            仅统计当前商圈、类别及 DEMO 筛选；连续日期合并。
+          </small>
+        </div>
+      </section>
+      <section className="panel">
+        <div className="panel-heading">
+          <h3>Upcoming Event Alert · Next 30 days</h3>
+          <Tag color="red">{upcoming.length} 个 HIGH 关注项</Tag>
+        </div>
+        <div className="outlook-content">
+          <small className="muted">
+            北京时间：{today} → {shiftDate(today, 29)}（含进行中活动）
+          </small>
+          {upcoming.slice(0, 3).map((event) => (
+            <div className="upcoming-row" key={event.id}>
+              <Button type="link" onClick={() => openEvent(event.id)}>
+                {event.name}
+              </Button>
+              <ImpactTag event={event} />
+              <small className="block muted">
+                {event.startDate} ·{" "}
+                {event.demo ? "DEMO 合成活动" : "规则优先级"}
+              </small>
+            </div>
+          ))}
+          {!upcoming.length && (
+            <Empty description="未来30天没有符合条件的 HIGH 活动" />
+          )}
+          <small className="block muted gap-top">
+            页面内提醒；未创建邮件、通知任务或自动价格调整。
+          </small>
+        </div>
+      </section>
+    </div>
+  );
+}
