diff --git a/frontend/src/components/DemandIntelligence/index.tsx b/frontend/src/components/DemandIntelligence/index.tsx
new file mode 100644
index 0000000..dbd9070
--- /dev/null
+++ b/frontend/src/components/DemandIntelligence/index.tsx
@@ -0,0 +1,162 @@
+import { Alert, Button, Descriptions, Empty, Space, Tag, Tooltip } from "antd";
+import type { Event } from "../../types";
+import { usePlatform } from "../../hooks/usePlatform";
+import {
+  assessDemand,
+  impactColors,
+  reviewPlan,
+} from "../../services/intelligence";
+
+export function ImpactTag({ event }: { event: Event }) {
+  const { dataset } = usePlatform();
+  const assessment = assessDemand(event, dataset);
+  return (
+    <Tooltip title={assessment.reasons.join("；")}>
+      <Tag color={impactColors[assessment.level]}>
+        Demand Impact: {assessment.level}
+        {event.demo ? " · DEMO" : " · 规则"}
+      </Tag>
+    </Tooltip>
+  );
+}
+export function DemandExplanation({ event }: { event: Event }) {
+  const { dataset, go } = usePlatform();
+  const a = assessDemand(event, dataset);
+  const plan = reviewPlan(event, a);
+  return (
+    <section className="intelligence-card">
+      <div className="section-heading">
+        <h3>Potential Demand Impact · 复核优先级</h3>
+        <ImpactTag event={event} />
+      </div>
+      <p className="muted">
+        {event.demo
+          ? "DEMO / Synthetic data / Not real event intelligence"
+          : "启发式规则输出，未经需求数据验证"}{" "}
+        · 范围仅限已配置酒店
+      </p>
+      <Descriptions
+        size="small"
+        column={1}
+        items={[
+          {
+            key: "hotel-count",
+            label: `${a.radiusKm} km 内核验酒店`,
+            children: `${a.nearbyHotels.length} 家（非全市场数量）`,
+          },
+          {
+            key: "nearest",
+            label: "最近酒店",
+            children:
+              a.nearestDistance === null
+                ? "未知"
+                : `${a.nearbyHotels[0].hotel.name} · ${a.nearestDistance.toFixed(2)} km`,
+          },
+          {
+            key: "score",
+            label: "规则评分",
+            children:
+              a.score === null ? "信息不足" : `${a.score} / 75 · 非需求概率`,
