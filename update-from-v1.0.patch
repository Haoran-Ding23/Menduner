+  font-size: 29px;
+  line-height: 1;
+  font-weight: 650;
+  color: #1d3556;
+}
+.stats-strip strong span {
+  font-size: 11px;
+  color: #9ba8bb;
+  font-weight: 400;
+  margin-left: 9px;
+}
+.stats-strip .stat-text {
+  font-size: 17px;
+  line-height: 29px;
+}
+.panel {
+  background: #fff;
+  border: 1px solid #e5ecf3;
+  border-radius: 13px;
+  box-shadow: 0 4px 15px #263c5503;
+  overflow: hidden;
+  min-width: 0;
+}
+.panel-heading {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 17px 19px;
+  border-bottom: 1px solid #edf1f6;
+  gap: 10px;
+  flex-wrap: wrap;
+}
+.map-layout {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 335px;
+  gap: 18px;
+}
+.map-shell {
+  position: relative;
+  height: 440px;
+  background: #f0f5f9;
+  overflow: hidden;
+}
+.amap-container {
+  width: 100%;
+  height: 100%;
+}
+.map-state {
