+* {
+  box-sizing: border-box;
+}
+body {
+  margin: 0;
+  background: #f5f7fb;
+  color: #1c2c44;
+  font-family: Inter, "Microsoft YaHei", system-ui, sans-serif;
+  font-size: 14px;
+}
+button,
+a,
+input {
+  -webkit-tap-highlight-color: transparent;
+}
+button {
+  font: inherit;
+}
+a {
+  color: #1677ff;
+}
+h1,
+h2,
+h3,
+p {
+  margin-top: 0;
+}
+h1 {
+  font-size: 27px;
+  letter-spacing: -0.7px;
+  margin: 7px 0 9px;
+}
+h1 span {
+  font-size: 17px;
+  color: #7d8c9f;
+  font-weight: 400;
+  margin-left: 10px;
+}
+h2 {
+  font-size: 21px;
+}
+h3 {
+  font-size: 15px;
+  margin: 0;
+}
+.platform {
+  display: flex;
+  min-height: 100vh;
+}
+.sidebar {
+  width: 232px;
+  flex-shrink: 0;
+  background: #fff;
+  border-right: 1px solid #e7edf4;
+  position: fixed;
+  inset: 0 auto 0 0;
