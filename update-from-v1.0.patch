+        ))}
+      </ul>
+      <Space wrap>
+        {a.nearbyHotels.map(({ hotel, distance }) => (
+          <Button
+            size="small"
+            key={hotel.id}
+            onClick={() => go("/hotels", event.id, { hotel: hotel.id })}
+          >
+            {hotel.name} · {distance.toFixed(2)} km
+          </Button>
+        ))}
+      </Space>
+    </section>
+  );
+}
+export function DecisionSupportPanel({
+  events,
+  hotelName,
+}: {
+  events: Event[];
+  hotelName?: string;
+}) {
+  const { dataset, openEvent, go } = usePlatform();
+  const ranked = events
+    .map((event) => ({ event, assessment: assessDemand(event, dataset) }))
+    .sort((a, b) => (b.assessment.score ?? -1) - (a.assessment.score ?? -1));
+  return (
+    <section className="panel gap-top">
+      <div className="panel-heading">
+        <h3>Decision Support · Revenue Manager 建议</h3>
+        <Tag color="blue">{hotelName ?? "已配置酒店"}</Tag>
+      </div>
+      <div className="decision-content">
+        <Alert
+          showIcon
+          type="info"
+          message="人工决策支持，不执行自动定价"
+          description="影响等级仅用于安排复核顺序。建议窗口为活动前 7–14 天；日历另提供提前 30 天的准备提醒，均可按酒店策略调整。"
+        />
+        {ranked.length ? (
+          <div className="decision-grid">
+            {ranked.slice(0, 4).map(({ event, assessment }) => {
+              const plan = reviewPlan(event, assessment);
+              return (
+                <article className="intelligence-card" key={event.id}>
+                  <Space wrap>
+                    <strong>{event.name}</strong>
+                    <ImpactTag event={event} />
+                  </Space>
+                  <p>{plan.action}</p>
+                  <small className="block muted">
+                    复核窗口：{plan.window?.join(" → ") ?? "待核验"} ·{" "}
+                    {plan.timing}
+                  </small>
+                  <small className="block muted">
+                    {event.demo
+                      ? "DEMO 合成活动 · 不是真实活动情报"
+                      : "启发式规则 · 非已验证需求预测"}
+                  </small>
+                  <details className="gap-top">
+                    <summary>为什么建议关注？</summary>
+                    <ul className="explanation-list">
+                      {assessment.reasons.map((r) => (
+                        <li key={r}>{r}</li>
+                      ))}
+                    </ul>
+                  </details>
+                  <Space className="gap-top">
+                    <Button size="small" onClick={() => openEvent(event.id)}>
+                      活动详情
+                    </Button>
+                    <Button
+                      size="small"
+                      onClick={() => go("/evidence", event.id)}
+                    >
+                      检查证据
+                    </Button>
+                  </Space>
+                </article>
+              );
+            })}
+          </div>
+        ) : (
+          <Empty description="当前筛选没有可评估的邻近活动；先核验数据再安排复核" />
+        )}
+      </div>
+    </section>
+  );
+}
