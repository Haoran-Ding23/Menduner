+import { Alert, Button, Table, Tag, Tooltip } from "antd";
+import type { Event } from "../../types";
+import { usePlatform } from "../../hooks/usePlatform";
+import {
+  districtOpportunities,
+  impactColors,
+  industryBreakdown,
+} from "../../services/intelligence";
+export default function OpportunityAnalysis({ events }: { events: Event[] }) {
+  const { dataset, filters, update } = usePlatform();
+  const comparison = districtOpportunities(events, dataset),
+    industries = industryBreakdown(events);
+  return (
+    <section className="panel gap-bottom">
+      <div className="panel-heading">
+        <h3>Commercial Area Opportunity · 商圈机会比较</h3>
+        <Tag>
+          {filters.year}年{filters.month}月 · 比较不受单商圈筛选影响
+        </Tag>
+      </div>
+      <div className="opportunity-content">
+        <Alert
+          type="info"
+          message="DEMO / 规则评分不是实际需求、收入或市场规模；配置酒店样本不能代替酒店密度。"
+        />
+        <div className="opportunity-grid gap-top">
+          {comparison.map((d) => (
+            <article className="intelligence-card" key={d.id}>
+              <div className="section-heading">
+                <h3>{d.name}</h3>
+                {d.demo && <Tag color="blue">DEMO</Tag>}
+              </div>
+              <strong className="opportunity-score">
+                {d.score ?? "—"}
+                <small> / 100 · 样本机会分</small>
+              </strong>
+              <Tag color={impactColors[d.potential]}>
+                Demand potential: {d.potential} · 规则信号
+              </Tag>
+              <ul className="explanation-list">
+                {d.reasons.map((reason) => (
+                  <li key={reason}>{reason}</li>
+                ))}
+              </ul>
+              <Button size="small" onClick={() => update({ district: d.id })}>
+                查看商圈活动
+              </Button>
+            </article>
+          ))}
+        </div>
+        <Table
+          rowKey="id"
+          className="gap-top"
+          dataSource={comparison}
+          pagination={false}
+          scroll={{ x: 650 }}
+          columns={[
+            { title: "商圈", dataIndex: "name" },
+            { title: "Events", dataIndex: "events" },
+            { title: "Business events", dataIndex: "businessEvents" },
+            {
+              title: "Hotel density",
+              render: () => <span>未知 · 缺少完整名录及面积</span>,
+            },
+            { title: "核验坐标的配置酒店", dataIndex: "configuredHotels" },
+            {
+              title: "Demand potential",
+              render: (_, d) => (
+                <Tooltip title={d.reasons.join("；")}>
+                  <Tag color={impactColors[d.potential]}>
+                    {d.potential}
+                    {d.demo ? " · DEMO" : ""}
+                  </Tag>
+                </Tooltip>
+              ),
+            },
+          ]}
+        />
+        <h3 className="gap-top">Industry category · 潜在客群假设</h3>
+        <div className="industry-grid gap-top">
