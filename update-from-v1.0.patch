+import { describe, it, expect } from "vitest";
+import { sampleDataset } from "../src/services/repository";
+import {
+  assessDemand,
+  nearbyHotels,
+  reviewPlan,
+  evidenceSummary,
+  businessToday,
+} from "../src/services/intelligence";
+import type { Dataset } from "../src/types";
+describe("V1.1 explainable review priority", () => {
+  it("derives DEMO HIGH from declared inputs and configured hotels only", () => {
+    const result = assessDemand(sampleDataset.events[0], sampleDataset);
+    expect(result).toMatchObject({ level: "HIGH", score: 75, basis: "DEMO" });
+    expect(result.nearbyHotels).toHaveLength(1);
+    expect(result.nearestDistance).toBeCloseTo(0.56, 2);
+    expect(result.reasons.join(" ")).toContain("未经需求数据校准");
+    expect(
+      nearbyHotels(sampleDataset.events[0], sampleDataset, 0.1),
+    ).toHaveLength(0);
+  });
+  it("does not classify real records with missing evidence or contradictory date evidence", () => {
+    const event = { ...sampleDataset.events[0], id: "real", demo: false };
+    const data: Dataset = { ...sampleDataset, events: [event], evidence: [] };
+    expect(assessDemand(event, data).level).toBe("UNKNOWN");
+    data.evidence = ["venueId", "category", "startDate", "endDate"].map(
+      (field) => ({
+        id: field,
+        entityId: "real",
+        field,
+        value: event[field as keyof typeof event],
+        status: "Verified",
+        method: "direct_web",
+        sourceName: "Organizer",
+        sourceUrl: "https://example.org/event",
+        updatedAt: "2026-10-12",
+      }),
+    );
+    expect(assessDemand(event, data).basis).toBe("RULE_BASED");
+    data.evidence.push({
+      ...data.evidence[2],
+      id: "conflict",
+      status: "Conflicting",
+      value: "2026-10-15",
+    });
+    expect(assessDemand(event, data).level).toBe("UNKNOWN");
+  });
+  it("withholds priority for missing dates and unknown event locations", () => {
+    expect(assessDemand(sampleDataset.events[9], sampleDataset).score).toBe(
+      null,
+    );
+    expect(assessDemand(sampleDataset.events[7], sampleDataset).level).toBe(
+      "UNKNOWN",
+    );
+  });
+  it("gives an explicit 7–14 day review window and handles past review dates", () => {
+    const event = sampleDataset.events[0];
+    const result = reviewPlan(
+      event,
+      assessDemand(event, sampleDataset),
+      "2026-10-12",
+    );
+    expect(result.window).toEqual(["2026-09-28", "2026-10-05"]);
+    expect(result.timing).toContain("进行中");
+    expect(result.action).toContain("人工复核");
+  });
+  it("keeps venue sources separate from event proof", () => {
+    const evidence = evidenceSummary(sampleDataset.events[0], sampleDataset);
+    expect(evidence.eventUrls).toHaveLength(0);
+    expect(evidence.venueUrls).toHaveLength(1);
+  });
+  it("anchors business date in Asia/Shanghai", () => {
+    expect(businessToday(new Date("2026-10-11T17:00:00Z"))).toBe("2026-10-12");
+  });
+});
+
+describe("V1.1 risk calendar and commercial sample analysis", () => {
+  it("merges contiguous high-priority days and clips ranges to selected month", async () => {
+    const { highImpactPeriods } = await import("../src/services/intelligence");
+    expect(
+      highImpactPeriods(sampleDataset.events, sampleDataset, 2026, 10),
+    ).toEqual([{ start: "2026-10-12", end: "2026-10-15" }]);
+    const cross = {
+      ...sampleDataset.events[0],
+      id: "cross",
+      startDate: "2026-10-30",
+      endDate: "2026-11-03",
+    };
+    expect(highImpactPeriods([cross], sampleDataset, 2026, 11)).toEqual([
+      { start: "2026-11-01", end: "2026-11-03" },
+    ]);
+  });
+  it("includes ongoing high events and excludes the 31st date from alerts", async () => {
+    const { upcomingHighEvents } = await import("../src/services/intelligence");
+    const edge = {
+      ...sampleDataset.events[0],
+      id: "edge",
+      startDate: "2026-11-11",
+      endDate: "2026-11-12",
+    };
+    expect(
+      upcomingHighEvents(
+        [...sampleDataset.events, edge],
+        sampleDataset,
+        "2026-10-12",
+      ).map((e) => e.id),
+    ).toEqual(["demo-01"]);
+    expect(upcomingHighEvents([], sampleDataset, "2026-10-12")).toEqual([]);
+  });
+  it("derives district counts and opportunity score without claiming hotel density", async () => {
+    const { districtOpportunities } = await import(
+      "../src/services/intelligence"
+    );
+    const events = sampleDataset.events.filter((e) =>
+      e.startDate?.startsWith("2026-10"),
+    );
+    const districts = districtOpportunities(events, sampleDataset);
+    expect(districts[0]).toMatchObject({
+      events: 2,
+      businessEvents: 1,
+      configuredHotels: 1,
+      score: 35,
+      potential: "MEDIUM",
+      demo: true,
+    });
+    expect(districts[1]).toMatchObject({
+      events: 3,
+      businessEvents: 0,
+      configuredHotels: 0,
+    });
+    expect(districtOpportunities([], sampleDataset)[0].score).toBe(null);
+  });
+  it("keeps every industry count derived from loaded events", async () => {
+    const { industryBreakdown } = await import("../src/services/intelligence");
+    const groups = industryBreakdown(sampleDataset.events);
+    expect(groups.reduce((s, g) => s + g.count, 0)).toBe(
+      sampleDataset.events.length,
+    );
+    expect(groups.find((g) => g.name.startsWith("Business"))?.count).toBe(2);
+  });
+});
+
+describe("V1.1 business graph, prototype queries and trust boundary", () => {
+  it("calculates bilingual query results rather than returning a fixed answer", async () => {
+    const { queryPrototype } = await import("../src/services/intelligence");
+    const context = { year: 2026, month: 10, includeDemo: true };
+    expect(
+      queryPrototype(
+        "Which events may affect Jinji Lake hotels in October?",
+        sampleDataset,
+        context,
+      ).events.map((e) => e.id),
+    ).toEqual(["demo-01"]);
+    expect(
+      queryPrototype("独墅湖酒店11月有哪些活动？", sampleDataset, context)
+        .events,
+    ).toHaveLength(0);
+    expect(
+      queryPrototype("金鸡湖酒店13月活动", sampleDataset, context).supported,
+    ).toBe(false);
+    expect(
+      queryPrototype("Predict hotel revenue", sampleDataset, context).supported,
+    ).toBe(false);
+    expect(
+      queryPrototype("金鸡湖酒店10月活动", sampleDataset, {
+        ...context,
+        includeDemo: false,
+      }).events,
+    ).toHaveLength(0);
+  });
+  it("adds a business decision hypothesis only when input can be assessed", async () => {
+    const { createRepository } = await import("../src/services/repository");
+    const g = createRepository(sampleDataset).getGraphData("demo-01");
+    expect(g.nodes.find((n) => n.kind === "DemandSignal")?.analytical).toBe(
+      true,
+    );
+    expect(g.edges.filter((e) => e.analytical).map((e) => e.label)).toEqual([
+      "MAY_SIGNAL",
+      "INFORMS_REVIEW",
+    ]);
+    expect(
+      createRepository(sampleDataset)
+        .getGraphData("demo-10")
+        .nodes.some((n) => n.analytical),
+    ).toBe(false);
+  });
+  it("selects synthetic organizer source, abstains on ties and never resolves real records", async () => {
+    const { resolveDemoConflict } = await import(
+      "../src/services/intelligence"
+    );
+    const candidates = [
+      {
+        id: "a",
+        value: "2026-10-12",
+        sourceName: "A",
+        sourceRole: "official_organizer" as const,
+        demo: true,
+      },
+      {
+        id: "b",
+        value: "2026-10-15",
+        sourceName: "B",
+        sourceRole: "other" as const,
+        demo: true,
+      },
+    ];
+    expect(resolveDemoConflict(candidates).selected?.id).toBe("a");
+    expect(
+      resolveDemoConflict([
+        candidates[0],
+        { ...candidates[1], sourceRole: "official_organizer" },
+      ]).selected,
+    ).toBe(null);
+    expect(
+      resolveDemoConflict([{ ...candidates[0], demo: false }]).selected,
+    ).toBe(null);
+    expect(
+      resolveDemoConflict([{ ...candidates[0], value: "2026-02-30" }]).selected,
+    ).toBe(null);
+  });
+  it("preserves bounded confidence metadata without upgrading unverified evidence", async () => {
+    const { normalizeDataset } = await import("../src/services/adapter");
+    const d = normalizeDataset({
+      events: [{ id: "e", name: "A" }],
+      evidence: [
+        {
+          id: "field",
+          entityId: "e",
+          field: "name",
+          value: "A",
+          confidence: 0.95,
+          confidenceMethod: "Extraction score",
+          sourceRole: "official_organizer",
+          status: "Unverified",
+        },
+      ],
+    });
+    expect(d.evidence[0]).toMatchObject({
+      confidence: 0.95,
+      status: "Unverified",
+      sourceRole: "official_organizer",
+    });
+    expect(
+      normalizeDataset({ events: [], evidence: [{ id: "x", confidence: 95 }] })
+        .evidence[0].confidence,
+    ).toBe(undefined);
+  });
+});
+
+it("does not invent a duration or completion date when event end is missing", () => {
+  const event = { ...sampleDataset.events[0], endDate: null };
+  const assessment = assessDemand(event, sampleDataset);
+  expect(assessment.score).toBe(60);
+  expect(assessment.reasons.join(" ")).toContain("结束日期未知");
+  expect(reviewPlan(event, assessment, "2026-10-18").timing).toContain(
+    "结束时间待核验",
+  );
+});
