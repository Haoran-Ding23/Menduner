@@ -0,0 +1,103 @@
+import { useState } from "react";
+import { Alert, Button, Steps, Tag } from "antd";
+import sample from "../../data/trust-demo.json";
+import {
+  resolveDemoConflict,
+  type ConflictCandidate,
+} from "../../services/intelligence";
+const stages = [
+  {
+    title: "Website",
+    text: "公开网页与来源 URL：保留原文、抓取时间和活动身份。",
+  },
+  {
+    title: "AI Extraction",
+    text: "未来采集流程可提取字段及原文片段；本前端未执行 AI 抽取。",
+  },
+  {
+    title: "Validation",
+    text: "核对日期、场馆、来源角色；缺失及冲突不自动成为已核验事实。",
+  },
+  {
+    title: "Evidence Database",
+    text: "前端目前是本地 JSON 证据适配器，没有实际数据库写入。",
+  },
+];
+export default function TrustCenter() {
+  const [stage, setStage] = useState(0);
+  const [resolution, setResolution] = useState<ReturnType<
+    typeof resolveDemoConflict
+  > | null>(null);
+  return (
+    <section className="panel gap-bottom">
+      <div className="panel-heading">
+        <h3>AI Data Trust Center · 数据可信流程</h3>
+        <Tag color="blue">流程原型</Tag>
+      </div>
+      <div className="trust-content">
+        <Steps
+          current={stage}
+          onChange={setStage}
+          size="small"
+          items={stages.map((s) => ({ title: s.title, status: "wait" }))}
+        />
+        <Alert
+          className="gap-top"
+          type="info"
+          message={stages[stage].text}
+          description="上图是流程说明，不表示 AI 已运行或真实数据库已连接。"
+        />
+        <div className="trust-demo-grid gap-top">
+          <article className="intelligence-card">
+            <h3>Field-level Confidence · 字段置信度</h3>
+            <Tag color="blue" className="gap-top">
+              DEMO · 独立合成场景
+            </Tag>
+            <p>{sample.field}</p>
+            <strong className="confidence-number">
+              {Math.round(sample.confidence * 100)}%<small> 合成演示分数</small>
+            </strong>
+            <p>Source: 示例主办方官网（无真实 URL，未核验）</p>
+            <small className="muted">
+              {sample.confidenceMethod}
+              ；不代表该字段有95%的事实正确概率，不改变任何活动的核验状态。
+            </small>
+          </article>
+          <article className="intelligence-card">
+            <h3>Conflict Resolution · 冲突复核演示</h3>
+            <Tag color="blue" className="gap-top">
+              DEMO · 不写入事实数据
+            </Tag>
+            {sample.candidates.map((c) => (
+              <p key={c.id}>
+                <strong>{c.sourceName}</strong>
+                <br />
+                {c.value}
+              </p>
+            ))}
+            <Button
+              onClick={() =>
+                setResolution(
+                  resolveDemoConflict(sample.candidates as ConflictCandidate[]),
+                )
+              }
+            >
+              运行 DEMO 冲突复核
+            </Button>
+            {resolution && (
+              <Alert
+                className="gap-top"
+                type={resolution.selected ? "info" : "warning"}
+                message={`AI decision · DEMO规则：${resolution.selected ? "建议选择 " + resolution.selected.value : "暂不选择"}`}
+                description={resolution.reason}
+              />
+            )}
+            <small className="block muted gap-top">
+              未调用 AI；真实事件保留原值及冲突，需人工确认。
+            </small>
+          </article>
+        </div>
+      </div>
+    </section>
+  );
+}
