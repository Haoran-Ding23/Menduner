# Public Web JSAPI key; restrict allowed domains in your AMap account.
VITE_AMAP_KEY=
# AMap REST calls cannot be signed in the browser, so they go through a proxy. `/_AMapService`
# is the local Vite dev proxy; a PRODUCTION build accepts only an absolute URL on another origin
# (e.g. https://proxy.example.com/_AMapService). With no usable proxy the SDK calls AMap
# directly: maps render, custom styles fall back. Do not point production at a relative path —
# nginx answers that with index.html and every map page throws "Unexpected token '<'".
VITE_AMAP_SERVICE_HOST=/_AMapService
# SERVER ONLY. Never rename this to VITE_*. Not bundled or committed.
AMAP_SECURITY_CODE=
# DEV SERVER ONLY (read by vite.config.ts, never bundled). The backend refuses writes without an
# authenticated caller. In production nginx forwards its basic-auth login as X-Menduner-Login;
# locally the dev proxy adds this value instead. Set it to any name (e.g. local-dev) to keep the
# review pages usable in development; leave it unset to get the same 401 a stranger gets.
MENDUNER_WRITE_LOGIN=
# SERVER ONLY: authorises scripted writes with `Authorization: Bearer <token>`.
MENDUNER_WRITE_TOKEN=
